# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

# Docker itself does not normally generate anything that needs
# ignoring. Keep these files committed:
#
# Dockerfile
# docker-compose.yml
# .dockerignore


# ------------------------------------------------------------
# Keep important Tauri/Rust files
# ------------------------------------------------------------

# Cargo.lock SHOULD be committed for an application.
!src-tauri/Cargo.lock

# Keep generated application icons in source control.
!src-tauri/icons/
!src-tauri/icons/**


# ------------------------------------------------------------
# Keep application source
# ------------------------------------------------------------

!web/
!web/**

!src-tauri/src/
!src-tauri/src/**

!src-tauri/tauri.conf.json